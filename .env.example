# Local live development. For production, follow docs/production-launch.md.
DATA_PROVIDER=kolhood
UPSTREAM_BASE_URL=https://kolhood.io
MARKET_DATA_PROVIDER=dexscreener
MARKET_DATA_CHAIN=robinhood
EXPLORER_BASE_URL=https://explorer.robinhood.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave DATABASE_URL empty only for local embedded PGlite.
DATABASE_URL=
DIRECT_URL=
PGLITE_DATA_DIR=.data/pglite
UPSTREAM_API_KEY=

# Generate independent random values before public deployment.
INTERNAL_SYNC_SECRET=
GUEST_HASH_SALT=analyst-dev-salt

# Server-only. Live Umbra quote preview works without a 0x key.
# Add your own 0x key to activate wallet-approved swaps, then redeploy.
ZERO_EX_API_KEY=
# Optional dedicated Robinhood mainnet RPC; public RPC is the default.
ROBINHOOD_RPC_URL=
