# Local live development. For production, follow docs/production-launch.md.
# Use chain for the V2 worker deployment. Legacy release uses kolhood.
DATA_PROVIDER=chain
UPSTREAM_BASE_URL=https://kolhood.io
MARKET_DATA_PROVIDER=dexscreener
MARKET_DATA_CHAIN=robinhood
EXPLORER_BASE_URL=https://explorer.robinhood.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave DATABASE_URL empty only for local embedded PGlite.
DATABASE_URL=
DIRECT_URL=
PGLITE_DATA_DIR=.data/pglite
UPSTREAM_API_KEY=

# Generate independent random values before public deployment.
INTERNAL_SYNC_SECRET=
GUEST_HASH_SALT=analyst-dev-salt

# V2 continuous Railway worker. Server-only; never use NEXT_PUBLIC for these.
ALCHEMY_RPC_URL=
ALCHEMY_WS_URL=
# Required explicit chain coverage start. Use a known historical block, not an invented genesis cursor.
INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=6
INDEXER_BATCH_BLOCKS=50
INDEXER_POLL_MS=4000
INDEXER_BLOCK_TRIGGER=poll
INDEXER_PORT=8080
# Railway HTTPS origin + an independent random secret of at least 32 characters.
INDEXER_URL=
INDEXER_SECRET=
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2
DEXSCREENER_BASE_URL=https://api.dexscreener.com
USD_QUOTE_ADDRESSES=
VERIFIED_POOL_ADDRESSES=
WRAPPED_NATIVE_ADDRESS=
# Optional research endpoint: see docs/base44-contract.md.
BASE44_AGENT_URL=
BASE44_AGENT_KEY=
BASE44_AGENT_ID=
STOCK_TOKEN_API_URL=
# Verified direct trading. Never guess deployments or copy hashes from another chain.
# Omit optional hash settings until verified; a blank hash is invalid configuration.
PONS_FACTORY_ADDRESS=
PONS_V1_FACTORY_ADDRESS=
# PONS_FACTORY_CODE_HASH=0x...
UNISWAP_FACTORY_ADDRESS=
UNISWAP_ROUTER_ADDRESS=
UNISWAP_QUOTER_ADDRESS=
# UNISWAP_ROUTER_CODE_HASH=0x...
# UNISWAP_QUOTER_CODE_HASH=0x...
UNISWAP_V4_POOL_MANAGER=
UNISWAP_V4_ROUTER=
UNISWAP_V4_QUOTER=
UNISWAP_V4_ROUTER_ABI_VERSION=classic
# UNISWAP_V4_ROUTER_CODE_HASH=0x...
# UNISWAP_V4_QUOTER_CODE_HASH=0x...
PERMIT2_ADDRESS=
# PERMIT2_CODE_HASH=0x...

# Shared source worker (server only)
WEBHOOK_FEED_ENABLED=0
LIVE_FEED_SOURCE=stalkchain
# Optional automatic external rankings; do not use another application's key.
CODEX_API_KEY=
BLOCKSCOUT_PRO_API_KEY=
