{
  "name": "analyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test scripts/regression.test.ts",
    "test:trading": "node --import tsx --test scripts/trading.test.ts",
    "test:v2": "node --conditions=react-server --import tsx --test scripts/v2.test.ts",
    "worker:build": "esbuild worker/stalkchain.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/worker.mjs",
    "worker:start": "node --conditions=react-server dist/worker.mjs",
    "worker:check": "npm run worker:build && node --conditions=react-server dist/worker.mjs --check",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "sync": "tsx --conditions=react-server scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:v2 && npm run test:chain && npm run test:trading && npm run worker:build && npm run build",
    "test:chain": "node --conditions=react-server --import tsx --test scripts/chain-provider.test.ts",
    "worker:stalkchain:build": "esbuild worker/stalkchain.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/stalkchain.mjs",
    "test:sources": "node --import tsx --test scripts/stalkchain.test.ts scripts/alchemy-webhook.test.ts scripts/webhook-consumer.test.ts scripts/leaderboard-data.test.ts scripts/wallet-token-data.test.ts",
    "test:markets": "node --conditions=react-server --import tsx --test scripts/market-data.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
